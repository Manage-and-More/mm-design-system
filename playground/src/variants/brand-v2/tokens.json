{
  "color": {
    "$type": "color",
    "semantic": {
      "background": {
        "$value": "#F5F5F7",
        "$description": "The canvas. Deviation from the palette: a warm screen grey between brand white and grey #E3E3E3.",
        "$extensions": {
          "mm": {
            "source": "Brand v2 (2026-10-09)",
            "modes": {
              "dark": "#0B0B0C"
            }
          }
        }
      },
      "background-subtle": {
        "$value": "#ECECEF",
        "$description": "Tab rails and quiet plates on the canvas.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "#1C1C1F"
            }
          }
        }
      },
      "background-inverse": {
        "$value": "{color.brand.black}",
        "$extensions": {
          "mm": {
            "modes": {
              "dark": "{color.brand.white}"
            }
          }
        }
      },
      "text": {
        "$value": "{color.brand.black}",
        "$extensions": {
          "mm": {
            "modes": {
              "dark": "{color.brand.white}"
            }
          }
        }
      },
      "text-muted": {
        "$value": "{color.neutral.black-80}",
        "$extensions": {
          "mm": {
            "modes": {
              "dark": "{color.neutral.black-40}"
            }
          }
        }
      },
      "text-inverse": {
        "$value": "{color.brand.white}",
        "$extensions": {
          "mm": {
            "modes": {
              "dark": "{color.brand.black}"
            }
          }
        }
      },
      "border": {
        "$value": "rgb(0 0 0 / 0.1)",
        "$description": "Hairlines between rows and sections.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "rgb(255 255 255 / 0.12)"
            }
          }
        }
      },
      "accent-text": {
        "$value": "{color.brand.blue}",
        "$extensions": {
          "mm": {
            "modes": {
              "dark": "{color.brand.blue}"
            }
          }
        }
      },
      "action": {
        "$value": "{color.brand.blue}",
        "$description": "Quiet by default, blue when it acts: links, action pills, status chips, the arrow sticker. The same blue as the band, the figures and the logo.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "{color.brand.blue}"
            }
          }
        }
      },
      "action-tint": {
        "$value": "rgb(0 113 227 / 0.08)",
        "$description": "Fill of an action pill at rest.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "rgb(41 151 255 / 0.14)"
            }
          }
        }
      },
      "focus-ring": {
        "$value": "{color.brand.blue}",
        "$extensions": {
          "mm": {
            "modes": {
              "dark": "{color.brand.blue}"
            }
          }
        }
      },
      "text-on-brand": {
        "$value": "{color.brand.white}",
        "$description": "Brand v2: text on the blue band is white (4.9:1); black on #0071E3 fails AA.",
        "$extensions": {
          "mm": {
            "source": "Brand v2"
          }
        }
      },
      "highlight": {
        "$value": "#BFDBFF",
        "$description": "Brand v2 has no accent colour. The highlight is a tint of the one blue: chart series after blue, black and the greys; never a surface or text.",
        "$extensions": {
          "mm": {
            "source": "Brand v2 (2026-10-09)",
            "modes": {
              "dark": "#1E3A5F"
            }
          }
        }
      }
    },
    "surface": {
      "raised": {
        "$value": "{color.brand.white}",
        "$description": "Cards, plates and the header material. Lifted by shadow.card, never by a border.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "#151517"
            }
          }
        }
      },
      "tile-light": {
        "$value": "{color.brand.white}",
        "$description": "Full-bleed tile. The colour change is the divider.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "#151517"
            }
          }
        }
      },
      "tile-parchment": {
        "$value": "#ECECEF",
        "$description": "Full-bleed parchment tile breaking two light tiles. A step darker than the canvas; the brand grey #E3E3E3 was tried and read too heavy.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "#1C1C1F"
            }
          }
        }
      },
      "tile-dark": {
        "$value": "{color.brand.black}",
        "$description": "Full-bleed dark tile, white text, links in brand blue.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "#000000"
            }
          }
        }
      },
      "band": {
        "$value": "#0071E3",
        "$description": "The one blue emphasis section per page, the same blue in both modes. Text on it is white.",
        "$extensions": {
          "mm": {
            "source": "Brand v2"
          }
        }
      }
    },
    "hairline": {
      "hi": {
        "$value": "{color.brand.blue}",
        "$description": "The lit stroke of a hairline figure: the only colour in the drawing.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "{color.brand.blue}"
            }
          }
        }
      },
      "edge": {
        "$value": "rgb(0 0 0 / 0.82)",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "rgb(255 255 255 / 0.8)"
            }
          }
        }
      },
      "mid": {
        "$value": "rgb(0 0 0 / 0.5)",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "rgb(255 255 255 / 0.48)"
            }
          }
        }
      },
      "lo": {
        "$value": "rgb(0 0 0 / 0.22)",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "rgb(255 255 255 / 0.2)"
            }
          }
        }
      }
    },
    "brand": {
      "blue": {
        "$value": "#0071E3",
        "$description": "Brand v2 blue: the system blue of Apple-style UI replaces the brand blue #00A2CD everywhere in this language (band, figures, logo, actions), so the page has one blue. A logged deviation; the programme site keeps #00A2CD.",
        "$extensions": {
          "mm": {
            "source": "Brand v2 (2026-10-09, product owner)",
            "modes": {
              "dark": "#2997FF"
            }
          }
        }
      }
    },
    "accessible": {
      "blue-text": {
        "$value": "#0071E3",
        "$description": "Brand v2: the blue itself passes AA on white (4.9:1); on near-black use the dark value.",
        "$extensions": {
          "mm": {
            "source": "Brand v2",
            "modes": {
              "dark": "#2997FF"
            }
          }
        }
      }
    }
  },
  "font": {
    "size": {
      "fluid": {
        "$type": "dimension",
        "$description": "Fluid sizes for Brand v2 pages, instead of the breakpoint steps of the programme site.",
        "display": {
          "$value": "clamp(2.75rem, 1.5rem + 5vw, 5.25rem)",
          "$extensions": {
            "mm": {
              "source": "Brand v2"
            }
          }
        },
        "heading": {
          "$value": "clamp(1.875rem, 1.25rem + 2.5vw, 3rem)",
          "$extensions": {
            "mm": {
              "source": "Brand v2"
            }
          }
        },
        "subheading": {
          "$value": "1.375rem",
          "$extensions": {
            "mm": {
              "source": "Brand v2"
            }
          }
        },
        "lead": {
          "$value": "clamp(1.125rem, 1rem + 0.6vw, 1.375rem)",
          "$extensions": {
            "mm": {
              "source": "Brand v2"
            }
          }
        },
        "body": {
          "$value": "1.0625rem",
          "$extensions": {
            "mm": {
              "source": "Brand v2"
            }
          }
        },
        "small": {
          "$value": "0.875rem",
          "$extensions": {
            "mm": {
              "source": "Brand v2"
            }
          }
        },
        "stat": {
          "$value": "clamp(2.5rem, 1.75rem + 2.5vw, 3.75rem)",
          "$extensions": {
            "mm": {
              "source": "Brand v2"
            }
          }
        }
      }
    },
    "line-height": {
      "headline": {
        "$value": 1.1,
        "$extensions": {
          "mm": {
            "source": "Brand v2 (apple-design §15)"
          }
        }
      },
      "display": {
        "$value": 1.05,
        "$extensions": {
          "mm": {
            "source": "Brand v2 (apple-design §15)"
          }
        }
      },
      "body": {
        "$value": 1.55,
        "$extensions": {
          "mm": {
            "source": "Brand v2"
          }
        }
      }
    },
    "letter-spacing": {
      "headline": {
        "$value": "-0.015em",
        "$description": "Deviation: the brand sets no tracking on headlines; Sharp Sans above 30px wants a little negative tracking.",
        "$extensions": {
          "mm": {
            "source": "Brand v2 (apple-design §15)"
          }
        }
      },
      "display": {
        "$value": "-0.02em",
        "$extensions": {
          "mm": {
            "source": "Brand v2 (apple-design §15)"
          }
        }
      }
    }
  },
  "radius": {
    "$description": "Radius grammar: xs/sm inline chips and small controls, md inputs and capsules, lg/xl cards and containers, pill = action.",
    "xs": {
      "$value": "5px",
      "$extensions": {
        "mm": {
          "source": "Brand v2"
        }
      }
    },
    "sm": {
      "$value": "8px",
      "$extensions": {
        "mm": {
          "source": "Brand v2"
        }
      }
    },
    "md": {
      "$value": "11px",
      "$extensions": {
        "mm": {
          "source": "Brand v2"
        }
      }
    },
    "lg": {
      "$value": "18px",
      "$extensions": {
        "mm": {
          "source": "Brand v2"
        }
      }
    },
    "xl": {
      "$value": "22px",
      "$extensions": {
        "mm": {
          "source": "Brand v2"
        }
      }
    },
    "card": {
      "$value": "{radius.lg}",
      "$extensions": {
        "mm": {
          "source": "Brand v2: cards use lg"
        }
      }
    },
    "feature": {
      "$value": "{radius.xl}",
      "$extensions": {
        "mm": {
          "source": "Brand v2: large containers use xl"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": [
        {
          "color": "rgb(0 0 0 / 0.04)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "rgb(0 0 0 / 0.05)",
          "offsetX": "0px",
          "offsetY": "6px",
          "blur": "16px",
          "spread": "-4px"
        },
        {
          "color": "rgb(0 0 0 / 0.06)",
          "offsetX": "0px",
          "offsetY": "18px",
          "blur": "40px",
          "spread": "-12px"
        }
      ],
      "$description": "Soft, layered, down-and-right: lifts surface cards off the canvas. Buttons and text stay flat.",
      "$extensions": {
        "mm": {
          "source": "Brand v2",
          "modes": {
            "dark": [
              {
                "color": "rgb(0 0 0 / 0.4)",
                "offsetX": "0px",
                "offsetY": "1px",
                "blur": "2px",
                "spread": "0px"
              },
              {
                "color": "rgb(0 0 0 / 0.5)",
                "offsetX": "0px",
                "offsetY": "10px",
                "blur": "28px",
                "spread": "-6px"
              }
            ]
          }
        }
      }
    },
    "card-hover": {
      "$value": [
        {
          "color": "rgb(0 0 0 / 0.05)",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "rgb(0 0 0 / 0.07)",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "28px",
          "spread": "-6px"
        },
        {
          "color": "rgb(0 0 0 / 0.09)",
          "offsetX": "0px",
          "offsetY": "28px",
          "blur": "56px",
          "spread": "-16px"
        }
      ],
      "$extensions": {
        "mm": {
          "source": "Brand v2",
          "modes": {
            "dark": [
              {
                "color": "rgb(0 0 0 / 0.5)",
                "offsetX": "0px",
                "offsetY": "2px",
                "blur": "4px",
                "spread": "0px"
              },
              {
                "color": "rgb(0 0 0 / 0.6)",
                "offsetX": "0px",
                "offsetY": "16px",
                "blur": "40px",
                "spread": "-8px"
              }
            ]
          }
        }
      }
    },
    "product": {
      "$value": {
        "color": "rgb(0 0 0 / 0.22)",
        "offsetX": "3px",
        "offsetY": "5px",
        "blur": "30px",
        "spread": "0px"
      },
      "$description": "The heavy product shadow: imagery resting on a surface only (the hero's figure plate).",
      "$extensions": {
        "mm": {
          "source": "Brand v2",
          "modes": {
            "dark": {
              "color": "rgb(0 0 0 / 0.7)",
              "offsetX": "3px",
              "offsetY": "5px",
              "blur": "30px",
              "spread": "0px"
            }
          }
        }
      }
    }
  },
  "motion": {
    "easing": {
      "spring": {
        "$value": "linear(0, 0.0036 1.1%, 0.0185 2.6%, 0.0588 4.6%, 0.1301 7.3%, 0.2411 10.9%, 0.3889 15.5%, 0.5587 21%, 0.7191 27%, 0.8373 33.3%, 0.9185 40.1%, 0.9669 47.7%, 0.9909 56.3%, 0.999 66.6%, 1)",
        "$description": "A critically damped spring (damping 1.0, response ~0.3s) as a CSS linear() curve.",
        "$extensions": {
          "mm": {
            "source": "Brand v2 (apple-design §4)"
          }
        }
      }
    },
    "duration": {
      "spring": {
        "$value": "420ms",
        "$extensions": {
          "mm": {
            "source": "Brand v2"
          }
        }
      }
    }
  },
  "layout": {
    "landing": {
      "container": {
        "$value": "75rem",
        "$extensions": {
          "mm": {
            "source": "Brand v2"
          }
        }
      },
      "header-height": {
        "$value": "3.25rem",
        "$extensions": {
          "mm": {
            "source": "Brand v2"
          }
        }
      },
      "section-gap": {
        "$value": "clamp(5rem, 3rem + 8vw, 9rem)",
        "$extensions": {
          "mm": {
            "source": "Brand v2"
          }
        }
      }
    }
  }
}
