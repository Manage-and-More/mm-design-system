{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Manage and More design tokens (W3C Design Tokens format). Single source of truth: edit this file, then run `python3 scripts/build_tokens.py`. `$extensions.mm.source` says where a value comes from: `pdf p.N` = Brand Guideline PDF page N; `website <file>` = the live manageandmore.de codebase (manage-and-more-website repo), adopted as the screen standard on 2026-10-07; `derived` = defined in this repo to make the brand usable on screens.",
  "color": {
    "brand": {
      "blue": {
        "$type": "color",
        "$value": "#00A2CD",
        "$description": "Primary brand colour. Logo symbol, accents, links, highlight surfaces. RGB 0 162 205, CMYK 76/16/12/0.",
        "$extensions": {
          "mm": {
            "source": "pdf p.17",
            "rgb": [
              0,
              162,
              205
            ],
            "cmyk": [
              76,
              16,
              12,
              0
            ],
            "role": "primary"
          }
        }
      },
      "yellow": {
        "$type": "color",
        "$value": "#FFED00",
        "$description": "Primary accent. Large surfaces, illustration fills, infographic highlights. Never as text on white. RGB 255 237 0, CMYK 0/0/100/0.",
        "$extensions": {
          "mm": {
            "source": "pdf p.17",
            "rgb": [
              255,
              237,
              0
            ],
            "cmyk": [
              0,
              0,
              100,
              0
            ],
            "role": "accent"
          }
        }
      },
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Primary. Text, wordmark, high-contrast surfaces. CMYK 0/0/0/100.",
        "$extensions": {
          "mm": {
            "source": "pdf p.17",
            "rgb": [
              0,
              0,
              0
            ],
            "cmyk": [
              0,
              0,
              0,
              100
            ],
            "role": "primary"
          }
        }
      },
      "white": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Primary. Backgrounds, reversed text and logo.",
        "$extensions": {
          "mm": {
            "source": "pdf p.17",
            "rgb": [
              255,
              255,
              255
            ],
            "cmyk": [
              0,
              0,
              0,
              0
            ],
            "role": "primary",
            "note": "PDF prints CMYK as C0 M70 Y0 B0, an obvious copy error; paper white is 0/0/0/0."
          }
        }
      },
      "grey": {
        "$type": "color",
        "$value": "#E3E3E3",
        "$description": "Primary light grey. Section backgrounds, cards, dividers on white. RGB 227 227 227.",
        "$extensions": {
          "mm": {
            "source": "pdf p.17",
            "rgb": [
              227,
              227,
              227
            ],
            "cmyk": [
              0,
              0,
              0,
              15
            ],
            "role": "primary",
            "note": "PDF prints CMYK as C0 M70 Y0 B15 (copy error); 0/0/0/15 matches the RGB value."
          }
        }
      }
    },
    "neutral": {
      "black-80": {
        "$type": "color",
        "$value": "#575756",
        "$description": "Secondary. 80% black. Secondary text, dark UI details.",
        "$extensions": {
          "mm": {
            "source": "pdf p.17",
            "rgb": [
              87,
              87,
              87
            ],
            "cmyk": [
              0,
              0,
              0,
              80
            ],
            "role": "secondary",
            "note": "PDF HEX is 575756 while RGB is 87/87/87 (#575757); the HEX value is kept."
          }
        }
      },
      "black-60": {
        "$type": "color",
        "$value": "#878787",
        "$description": "Secondary. 60% black. Captions, meta text on white (large sizes only, see accessibility).",
        "$extensions": {
          "mm": {
            "source": "pdf p.17",
            "rgb": [
              135,
              135,
              135
            ],
            "cmyk": [
              0,
              0,
              0,
              60
            ],
            "role": "secondary"
          }
        }
      },
      "black-40": {
        "$type": "color",
        "$value": "#B2B2B2",
        "$description": "Secondary. 40% black. Borders, disabled states, chart gridlines.",
        "$extensions": {
          "mm": {
            "source": "pdf p.17",
            "rgb": [
              178,
              178,
              178
            ],
            "cmyk": [
              0,
              0,
              0,
              40
            ],
            "role": "secondary"
          }
        }
      }
    },
    "semantic": {
      "text": {
        "$type": "color",
        "$value": "{color.brand.black}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "text-muted": {
        "$type": "color",
        "$value": "{color.neutral.black-80}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "text-inverse": {
        "$type": "color",
        "$value": "{color.brand.white}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "background": {
        "$type": "color",
        "$value": "{color.brand.white}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "background-subtle": {
        "$type": "color",
        "$value": "{color.brand.grey}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "background-inverse": {
        "$type": "color",
        "$value": "{color.brand.black}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "background-brand": {
        "$type": "color",
        "$value": "{color.brand.blue}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "{color.brand.blue}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.brand.yellow}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.black-40}",
        "$extensions": {
          "mm": {
            "source": "derived"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.accessible.blue-text}",
        "$description": "Focus outline on white and black (>= 3:1). On blue surfaces use black. The website currently uses off-palette #4443FE.",
        "$extensions": {
          "mm": {
            "source": "derived (WCAG 2.2 non-text contrast)"
          }
        }
      },
      "text-on-brand": {
        "$type": "color",
        "$value": "{color.brand.black}",
        "$description": "Text on blue surfaces is black (7.05:1). White on blue is 2.98:1 and fails AA at every size.",
        "$extensions": {
          "mm": {
            "source": "derived (WCAG AA), approved 2026-10-07"
          }
        }
      },
      "accent-text": {
        "$type": "color",
        "$value": "{color.accessible.blue-text}",
        "$description": "Blue text on white. On black use color.brand.blue (7.05:1).",
        "$extensions": {
          "mm": {
            "source": "derived (WCAG AA), approved 2026-10-07"
          }
        }
      }
    },
    "accessible": {
      "$description": "Shades that exist only to pass WCAG 2.2 AA. Not new brand colours: use them only where the brand colour itself fails contrast.",
      "blue-text": {
        "$type": "color",
        "$value": "#007D9E",
        "$description": "Deeper M&M blue for blue TEXT and focus rings on white (4.74:1) and black (4.43:1). Use instead of #00A2CD for small blue text on light backgrounds (subtitles, phase labels, kickers). Not for surfaces, not for the logo. On grey #E3E3E3 it is 3.7:1: use black text there.",
        "$extensions": {
          "mm": {
            "source": "derived (WCAG AA), approved 2026-10-07"
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "brand": {
        "$type": "fontFamily",
        "$value": [
          "Sharp Sans",
          "Work Sans",
          "Arial",
          "sans-serif"
        ],
        "$description": "House typeface Sharp Sans. Manage and More holds a licence (confirmed by the team 2026-10-07) and uses it on manageandmore.de. Font files are NOT in this repo: copy them from the website repo (src/fonts/). Work Sans is the bundled fallback.",
        "$extensions": {
          "mm": {
            "source": "pdf p.18-20; website src/lib/fonts.ts"
          }
        }
      },
      "web": {
        "$type": "fontFamily",
        "$value": [
          "Sharp Sans",
          "Work Sans",
          "Arial",
          "sans-serif"
        ],
        "$description": "Default stack for web code. Load licensed Sharp Sans Medium 500 and Extrabold 800 where the project has the files; otherwise the bundled Work Sans renders.",
        "$extensions": {
          "mm": {
            "source": "website src/lib/fonts.ts (approved 2026-10-07)"
          }
        }
      },
      "open": {
        "$type": "fontFamily",
        "$value": [
          "Work Sans",
          "Arial",
          "sans-serif"
        ],
        "$description": "Free stack for projects without the Sharp Sans files (external agencies, public templates, Google Docs). Work Sans is bundled in assets/fonts/work-sans (SIL OFL).",
        "$extensions": {
          "mm": {
            "source": "pdf p.20"
          }
        }
      },
      "office": {
        "$type": "fontFamily",
        "$value": [
          "Arial",
          "sans-serif"
        ],
        "$description": "External correspondence, e-mail signatures, PowerPoint.",
        "$extensions": {
          "mm": {
            "source": "pdf p.21"
          }
        }
      }
    },
    "weight": {
      "body": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Sharp Sans Medium / Work Sans Medium. The website loads only 500 and 800.",
        "$extensions": {
          "mm": {
            "source": "pdf p.18-20"
          }
        }
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$extensions": {
          "mm": {
            "source": "pdf p.20"
          }
        },
        "$description": "Work Sans only (no Sharp Sans Regular file is used on the website)."
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Work Sans only. With Sharp Sans use 800; 700 would be synthesised by the browser.",
        "$extensions": {
          "mm": {
            "source": "pdf p.20"
          }
        }
      },
      "headline": {
        "$type": "fontWeight",
        "$value": 800,
        "$description": "Sharp Sans Extrabold / Work Sans ExtraBold. Headlines are always bold.",
        "$extensions": {
          "mm": {
            "source": "pdf p.18-19"
          }
        }
      }
    },
    "size": {
      "$description": "Screen type scale adopted from manageandmore.de (approved 2026-10-07), stored in rem (16px root). Responsive steps: `mobile` applies from 0, the others from the `min-width` in $extensions.mm.min-width. Print and slides keep the PDF sizes (see guidelines/05-typography.md).",
      "display": {
        "$description": "Hero / page title (h1). Class .display-title on the website.",
        "mobile": {
          "$type": "dimension",
          "$value": "1.875rem",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 30
            }
          }
        },
        "tablet": {
          "$type": "dimension",
          "$value": "3.125rem",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 50,
              "min-width": "768px"
            }
          }
        },
        "laptop": {
          "$type": "dimension",
          "$value": "2.5rem",
          "$description": "The website deliberately steps down at 992px, where the hero shares the width with the badge.",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 40,
              "min-width": "992px"
            }
          }
        },
        "desktop": {
          "$type": "dimension",
          "$value": "3.125rem",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 50,
              "min-width": "1200px"
            }
          }
        },
        "wide": {
          "$type": "dimension",
          "$value": "4.6875rem",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 75,
              "min-width": "1536px"
            }
          }
        }
      },
      "heading": {
        "$description": "Section heading (h2), including the two-tone outline/solid heading. Class .section-title on the website.",
        "mobile": {
          "$type": "dimension",
          "$value": "1.5625rem",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 25
            }
          }
        },
        "desktop": {
          "$type": "dimension",
          "$value": "3.125rem",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 50,
              "min-width": "768px"
            }
          }
        }
      },
      "lead": {
        "$description": "Intro statement next to or under a heading (e.g. 'The aim of Manage and More is...').",
        "mobile": {
          "$type": "dimension",
          "$value": "1.25rem",
          "$extensions": {
            "mm": {
              "source": "website src/app/program/page.tsx",
              "px": 20
            }
          }
        },
        "desktop": {
          "$type": "dimension",
          "$value": "1.875rem",
          "$extensions": {
            "mm": {
              "source": "website src/app/program/page.tsx",
              "px": 30,
              "min-width": "768px"
            }
          }
        }
      },
      "subheading": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$description": "h3 inside a section.",
        "$extensions": {
          "mm": {
            "source": "website (text-2xl: timeline phases, 'Events for fun')",
            "px": 24
          }
        }
      },
      "title": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$description": "Card and list-item titles, Extrabold.",
        "$extensions": {
          "mm": {
            "source": "website (text-xl: photo-card, person and testimonial titles)",
            "px": 20
          }
        }
      },
      "body": {
        "$description": "Body copy. Set on <body>; paragraphs inherit it.",
        "mobile": {
          "$type": "dimension",
          "$value": "0.9375rem",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 15
            }
          }
        },
        "tablet": {
          "$type": "dimension",
          "$value": "1.0625rem",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 17,
              "min-width": "768px"
            }
          }
        },
        "desktop": {
          "$type": "dimension",
          "$value": "1.25rem",
          "$extensions": {
            "mm": {
              "source": "website src/styles/theme.css",
              "px": 20,
              "min-width": "1200px"
            }
          }
        }
      },
      "small": {
        "$type": "dimension",
        "$value": "0.875rem",
        "$description": "Footer links, chips, meta lines, roles.",
        "$extensions": {
          "mm": {
            "source": "website (text-sm: footer, captions, chips, roles)",
            "px": 14
          }
        }
      },
      "caption": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "Smallest text (stat labels on mobile).",
        "$extensions": {
          "mm": {
            "source": "website src/components/StatRow.tsx",
            "px": 12
          }
        }
      },
      "stat": {
        "$description": "Big number in a stat row.",
        "mobile": {
          "$type": "dimension",
          "$value": "1.875rem",
          "$extensions": {
            "mm": {
              "source": "website src/components/StatRow.tsx",
              "px": 30
            }
          }
        },
        "tablet": {
          "$type": "dimension",
          "$value": "2.5rem",
          "$extensions": {
            "mm": {
              "source": "website src/components/StatRow.tsx",
              "px": 40,
              "min-width": "640px"
            }
          }
        },
        "desktop": {
          "$type": "dimension",
          "$value": "3.125rem",
          "$extensions": {
            "mm": {
              "source": "website src/components/StatRow.tsx",
              "px": 50,
              "min-width": "1280px"
            }
          }
        }
      },
      "stat-label": {
        "mobile": {
          "$type": "dimension",
          "$value": "0.75rem",
          "$extensions": {
            "mm": {
              "source": "website src/components/StatRow.tsx",
              "px": 12
            }
          }
        },
        "desktop": {
          "$type": "dimension",
          "$value": "0.9375rem",
          "$extensions": {
            "mm": {
              "source": "website src/components/StatRow.tsx",
              "px": 15,
              "min-width": "1024px"
            }
          }
        }
      },
      "nav": {
        "$type": "dimension",
        "$value": "0.95rem",
        "$description": "Desktop header navigation links, Medium 500.",
        "$extensions": {
          "mm": {
            "source": "website src/components/Header.tsx",
            "px": 15.2
          }
        }
      },
      "nav-mobile": {
        "$type": "dimension",
        "$value": "1.875rem",
        "$description": "Full-screen mobile menu items, Extrabold.",
        "$extensions": {
          "mm": {
            "source": "website src/components/Header.tsx",
            "px": 30
          }
        }
      }
    },
    "line-height": {
      "headline": {
        "$type": "number",
        "$value": 1.15,
        "$description": "Screen headlines. Leaves room for the outline stroke in two-tone headings.",
        "$extensions": {
          "mm": {
            "source": "website src/app/globals.css (approved 2026-10-07)"
          }
        }
      },
      "headline-print": {
        "$type": "number",
        "$value": 1.0,
        "$description": "Print, slides and other designed media: headlines 100% leading.",
        "$extensions": {
          "mm": {
            "source": "pdf p.18"
          }
        }
      },
      "body": {
        "$type": "number",
        "$value": 1.5,
        "$extensions": {
          "mm": {
            "source": "website src/app/globals.css"
          }
        }
      },
      "tight": {
        "$type": "number",
        "$value": 1.0,
        "$description": "Stat numbers and one-line labels.",
        "$extensions": {
          "mm": {
            "source": "website src/components/StatRow.tsx"
          }
        }
      }
    },
    "letter-spacing": {
      "headline": {
        "$type": "dimension",
        "$value": "0em",
        "$description": "Headlines are not tracked on the website (was -0.01em, derived).",
        "$extensions": {
          "mm": {
            "source": "website src/app/globals.css"
          }
        }
      },
      "label": {
        "$type": "dimension",
        "$value": "0.025em",
        "$description": "Small uppercase labels, e.g. footer column headings.",
        "$extensions": {
          "mm": {
            "source": "website src/components/Footer.tsx"
          }
        }
      },
      "meta": {
        "$type": "dimension",
        "$value": "0.08em",
        "$description": "Uppercase role / meta lines under names.",
        "$extensions": {
          "mm": {
            "source": "website src/app/people/page.tsx"
          }
        }
      },
      "eyebrow": {
        "$type": "dimension",
        "$value": "0.16em",
        "$description": "Uppercase kicker above a heading (e.g. '12 companies').",
        "$extensions": {
          "mm": {
            "source": "website src/components/StartupGrid.tsx"
          }
        }
      }
    }
  },
  "opacity": {
    "$description": "Opacity steps for text, dividers and photo shades. The website tints text with currentColor/opacity instead of extra greys. Check contrast: black text below 0.6 opacity on white fails AA for small text.",
    "text-secondary": {
      "$type": "number",
      "$value": 0.9,
      "$description": "Body copy on black sections.",
      "$extensions": {
        "mm": {
          "source": "website (text-light/90)"
        }
      }
    },
    "text-muted": {
      "$type": "number",
      "$value": 0.7,
      "$description": "Secondary text, footer links. 8.4:1 on white, 10:1 on black.",
      "$extensions": {
        "mm": {
          "source": "website (text-dark/70, text-light/70)"
        }
      }
    },
    "text-subtle": {
      "$type": "number",
      "$value": 0.5,
      "$description": "White on black only (5.3:1). Black at 0.5 on white is 3.9:1: do not use for small text.",
      "$extensions": {
        "mm": {
          "source": "website (text-light/50)"
        }
      }
    },
    "divider": {
      "$type": "number",
      "$value": 0.2,
      "$description": "Hairline between sections and FAQ rows, in currentColor.",
      "$extensions": {
        "mm": {
          "source": "website (border-current/20)"
        }
      }
    },
    "shade-light": {
      "$type": "number",
      "$value": 0.2,
      "$description": "Black shade over calm, dark hero photos.",
      "$extensions": {
        "mm": {
          "source": "website src/components/Hero.tsx"
        }
      }
    },
    "shade": {
      "$type": "number",
      "$value": 0.4,
      "$description": "Default black shade over hero photos and video.",
      "$extensions": {
        "mm": {
          "source": "website src/components/Hero.tsx"
        }
      }
    },
    "shade-strong": {
      "$type": "number",
      "$value": 0.6,
      "$description": "Busy or bright hero images.",
      "$extensions": {
        "mm": {
          "source": "website src/app/alumni-network/page.tsx"
        }
      }
    },
    "shade-solid": {
      "$type": "number",
      "$value": 0.7,
      "$description": "Photo behind long text (contact CTA band).",
      "$extensions": {
        "mm": {
          "source": "website src/app/alumni-network/page.tsx"
        }
      }
    },
    "placeholder-min": {
      "$type": "number",
      "$value": 0.05,
      "$description": "Loading placeholder pulse, low point (currentColor).",
      "$extensions": {
        "mm": {
          "source": "live manageandmore.de styles.css"
        }
      }
    },
    "placeholder-max": {
      "$type": "number",
      "$value": 0.15,
      "$description": "Loading placeholder pulse, high point.",
      "$extensions": {
        "mm": {
          "source": "live manageandmore.de styles.css"
        }
      }
    }
  },
  "logo": {
    "clear-space": {
      "$type": "dimension",
      "$value": "0.5U",
